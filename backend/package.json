{
  "name": "ai-live-chat-agent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the AI Live Chat Agent (Node.js + TypeScript + Express + Prisma).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.33.1",
    "@prisma/client": "6.2.1",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "openai": "4.77.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "prisma": "6.2.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
